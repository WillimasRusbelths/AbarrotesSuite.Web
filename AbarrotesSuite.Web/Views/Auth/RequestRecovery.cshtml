@model AbarrotesSuite.Web.Models.Auth.AccountRecoveryRequestVm
@{
    ViewData["Title"] = "Recuperar cuenta";
}
<h3>Recuperación de cuenta</h3>
@if (TempData["msg"] is string m){<div class="alert alert-info">@m</div>}
<form method="post">
  @Html.AntiForgeryToken()
  <div class="row g-3">
    <div class="col-md-4">
      <label class="form-label">Usuario</label>
      <input asp-for="Username" class="form-control" />
    </div>
    <div class="col-md-4">
      <label class="form-label">Documento</label>
      <input asp-for="Documento" class="form-control" />
    </div>
    <div class="col-md-4">
      <label class="form-label">Teléfono</label>
      <input asp-for="Telefono" class="form-control" />
    </div>
    <div class="col-md-4">
      <label class="form-label">Email</label>
      <input asp-for="Email" type="email" class="form-control" />
    </div>
    <div class="col-md-4">
      <label class="form-label">Rol solicitado</label>
      <select asp-for="RolSolicitado" class="form-select">
        <option value="">-- Seleccione --</option>
        <option>admin</option>
        <option>cajero</option>
        <option>supervisor</option>
        <option>almacenero</option>
      </select>
    </div>
    <div class="col-12">
      <label class="form-label">Motivo</label>
      <textarea asp-for="Motivo" class="form-control" rows="3"></textarea>
    </div>
  </div>
  <div class="mt-3">
    <button class="btn btn-primary" type="submit">Enviar solicitud</button>
    <a class="btn btn-secondary" asp-action="Login">Volver al login</a>
  </div>
</form>

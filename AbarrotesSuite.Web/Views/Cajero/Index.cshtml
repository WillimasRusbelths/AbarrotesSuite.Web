@model AbarrotesSuite.Web.Models.Cajero.CashierDashboardVm
@{
    ViewData["Title"] = "Panel de cajero";
}
<h3 class="mb-3">Panel de cajero</h3>
<div class="mb-3 d-flex gap-2">
  <a class="btn btn-primary" asp-controller="Ventas" asp-action="Pos">Ir al POS</a>
  @if (Model.UltimasVentas.Any())
  {
    var last = Model.UltimasVentas.First();
    <a class="btn btn-outline-secondary" asp-controller="Ventas" asp-action="Ticket" asp-route-id="@last.Id" target="_blank">Último ticket (#@last.Id)</a>
  }
</div>
<div class="row g-3 mb-3">
  <div class="col-md-4">
    <div class="card text-bg-light"><div class="card-body">
      <h6 class="card-title">Tickets hoy</h6>
      <p class="display-6">@Model.TicketsHoy</p>
    </div></div>
  </div>
  <div class="col-md-4">
    <div class="card text-bg-light"><div class="card-body">
      <h6 class="card-title">Monto hoy (S/)</h6>
      <p class="display-6">@Model.MontoHoy.ToString("N2")</p>
    </div></div>
  </div>
  <div class="col-md-4">
    <div class="card text-bg-light"><div class="card-body">
      <h6 class="card-title">Unidades vendidas</h6>
      <p class="display-6">@Model.UnidadesVendidasHoy.ToString("N2")</p>
    </div></div>
  </div>
</div>

<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <span>Mis últimas ventas (hoy)</span>
    <a class="btn btn-sm btn-outline-primary" asp-controller="Ventas" asp-action="Pos">Vender ahora</a>
  </div>
  <table class="table table-sm mb-0">
    <thead><tr><th>#</th><th>Fecha (UTC)</th><th class="text-end">Total</th><th>Estado</th><th></th></tr></thead>
    <tbody>
    @if (!Model.UltimasVentas.Any())
    {
        <tr><td colspan="5" class="text-center text-muted">Sin ventas hoy</td></tr>
    }
    else
    {
        foreach (var v in Model.UltimasVentas)
        {
            <tr>
              <td>@v.Id</td>
              <td>@v.Fecha.ToString("yyyy-MM-dd HH:mm:ss")</td>
              <td class="text-end">@v.Total.ToString("N2")</td>
              <td>@v.Estado</td>
              <td><a class="btn btn-sm btn-outline-secondary" asp-controller="Ventas" asp-action="Ticket" asp-route-id="@v.Id" target="_blank">Ticket</a></td>
            </tr>
        }
    }
    </tbody>
  </table>
</div>

@model AbarrotesSuite.Web.Models.Supervisor.ReportsVm
@{
    ViewData["Title"] = "Reportes";
}
<h3 class="mb-3">Reportes (Supervisor)</h3>
<form method="post" class="row g-2 mb-3">
  <div class="col-md-3">
    <label class="form-label">Desde</label>
    <input asp-for="StartDate" type="date" class="form-control" />
  </div>
  <div class="col-md-3">
    <label class="form-label">Hasta</label>
    <input asp-for="EndDate" type="date" class="form-control" />
  </div>
  <div class="col-md-3 align-self-end">
    <button class="btn btn-primary" type="submit">Aplicar</button>
  </div>
</form>
<div class="row g-3 mb-3">
  <div class="col-md-2"><div class="card text-bg-light"><div class="card-body"><div>Tickets</div><div class="display-6">@Model.Tickets</div></div></div></div>
  <div class="col-md-2"><div class="card text-bg-light"><div class="card-body"><div>Monto</div><div class="display-6">@Model.Monto.ToString("N2")</div></div></div></div>
  <div class="col-md-2"><div class="card text-bg-light"><div class="card-body"><div>Promedio</div><div class="display-6">@Model.TicketPromedio.ToString("N2")</div></div></div></div>
  <div class="col-md-2"><div class="card text-bg-light"><div class="card-body"><div>Unidades</div><div class="display-6">@Model.Unidades.ToString("N2")</div></div></div></div>
  <div class="col-md-2"><div class="card text-bg-light"><div class="card-body"><div>Anuladas</div><div class="display-6">@Model.Anuladas</div></div></div></div>
</div>

<div class="row g-3">
  <div class="col-md-6">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span>Ventas por usuario</span>
        <a class="btn btn-sm btn-outline-secondary" asp-action="ExportUsuariosCsv" asp-route-startDate="@Model.StartDate.ToString("yyyy-MM-dd")" asp-route-endDate="@Model.EndDate.ToString("yyyy-MM-dd")">Export CSV</a>
      </div>
      <table class="table table-sm mb-0">
        <thead><tr><th>Usuario</th><th class="text-end">Monto</th><th class="text-end">Tickets</th></tr></thead>
        <tbody>
        @foreach (var r in Model.VentasPorUsuario)
        {
            <tr><td>@r.Clave</td><td class="text-end">@r.Monto.ToString("N2")</td><td class="text-end">@r.Cantidad</td></tr>
        }
        </tbody>
      </table>
    </div>
  </div>
  <div class="col-md-6">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span>Pagos por método</span>
        <a class="btn btn-sm btn-outline-secondary" asp-action="ExportPagosCsv" asp-route-startDate="@Model.StartDate.ToString("yyyy-MM-dd")" asp-route-endDate="@Model.EndDate.ToString("yyyy-MM-dd")">Export CSV</a>
      </div>
      <table class="table table-sm mb-0">
        <thead><tr><th>Método</th><th class="text-end">Monto</th><th class="text-end">Cantidad</th></tr></thead>
        <tbody>
        @foreach (var r in Model.PagosPorMetodo)
        {
            <tr><td>@r.Clave</td><td class="text-end">@r.Monto.ToString("N2")</td><td class="text-end">@r.Cantidad</td></tr>
        }
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class="row g-3 mt-3">
  <div class="col-md-6">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span>Top productos (Unidades)</span>
        <a class="btn btn-sm btn-outline-secondary" asp-action="ExportTopProductosCsv" asp-route-startDate="@Model.StartDate.ToString("yyyy-MM-dd")" asp-route-endDate="@Model.EndDate.ToString("yyyy-MM-dd")" asp-route-tipo="unidades">Export CSV</a>
      </div>
      <table class="table table-sm mb-0">
        <thead><tr><th>SKU</th><th>Producto</th><th class="text-end">Unidades</th></tr></thead>
        <tbody>
        @foreach (var r in Model.TopUnidades)
        {
            <tr><td>@r.Sku</td><td>@r.Nombre</td><td class="text-end">@r.Valor.ToString("N2")</td></tr>
        }
        </tbody>
      </table>
    </div>
  </div>
  <div class="col-md-6">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span>Top productos (Monto)</span>
        <a class="btn btn-sm btn-outline-secondary" asp-action="ExportTopProductosCsv" asp-route-startDate="@Model.StartDate.ToString("yyyy-MM-dd")" asp-route-endDate="@Model.EndDate.ToString("yyyy-MM-dd")" asp-route-tipo="monto">Export CSV</a>
      </div>
      <table class="table table-sm mb-0">
        <thead><tr><th>SKU</th><th>Producto</th><th class="text-end">Monto</th></tr></thead>
        <tbody>
        @foreach (var r in Model.TopMonto)
        {
            <tr><td>@r.Sku</td><td>@r.Nombre</td><td class="text-end">@r.Valor.ToString("N2")</td></tr>
        }
        </tbody>
      </table>
    </div>
  </div>
</div>

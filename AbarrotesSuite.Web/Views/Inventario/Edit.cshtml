@model AbarrotesSuite.Web.Models.Inventario.EditProductVm
@{
    ViewData["Title"] = "Editar producto";
}
<h3>Editar producto</h3>
<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />
    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="Sku" class="form-label"></label>
            <input asp-for="Sku" class="form-control" />
            <span asp-validation-for="Sku" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Barcode" class="form-label"></label>
            <input asp-for="Barcode" class="form-control" />
            <span asp-validation-for="Barcode" class="text-danger"></span>
        </div>
        <div class="col-md-8">
            <label asp-for="Nombre" class="form-label"></label>
            <input asp-for="Nombre" class="form-control" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Precio" class="form-label"></label>
            <input asp-for="Precio" class="form-control" />
            <span asp-validation-for="Precio" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Costo" class="form-label"></label>
            <input asp-for="Costo" class="form-control" />
            <span asp-validation-for="Costo" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="UnidadId" class="form-label"></label>
            <select asp-for="UnidadId" class="form-select" asp-items="Model.Unidades"></select>
            <span asp-validation-for="UnidadId" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="CategoriaId" class="form-label"></label>
            <select asp-for="CategoriaId" class="form-select" asp-items="Model.Categorias"></select>
            <span asp-validation-for="CategoriaId" class="text-danger"></span>
        </div>
        <div class="col-md-2 form-check">
            <input class="form-check-input" asp-for="Activo" />
            <label asp-for="Activo" class="form-check-label"></label>
        </div>
    </div>
    <div class="mt-3">
        <button class="btn btn-primary" type="submit">Guardar</button>
        <a class="btn btn-secondary" asp-action="Index">Volver</a>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
